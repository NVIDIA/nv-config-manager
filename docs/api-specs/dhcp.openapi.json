{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LeaseArguments": {
        "additionalProperties": false,
        "description": "Arguments accepted by the supported KEA lease commands.",
        "properties": {
          "ip-address": {
            "format": "ipv4",
            "title": "Ip-Address",
            "type": "string"
          }
        },
        "required": [
          "ip-address"
        ],
        "title": "LeaseArguments",
        "type": "object"
      },
      "LeaseDashboardResponse": {
        "description": "Lease, reservation, and pool data used by the splash-page dashboard.",
        "properties": {
          "active_lease_count": {
            "title": "Active Lease Count",
            "type": "integer"
          },
          "assigned_address_count": {
            "title": "Assigned Address Count",
            "type": "integer"
          },
          "leases": {
            "items": {
              "$ref": "#/components/schemas/LeaseRecord"
            },
            "title": "Leases",
            "type": "array"
          },
          "leases_truncated": {
            "title": "Leases Truncated",
            "type": "boolean"
          },
          "pool_address_count": {
            "title": "Pool Address Count",
            "type": "integer"
          },
          "pools": {
            "items": {
              "$ref": "#/components/schemas/PoolUsage"
            },
            "title": "Pools",
            "type": "array"
          },
          "reservation_count": {
            "title": "Reservation Count",
            "type": "integer"
          },
          "reservations": {
            "items": {
              "$ref": "#/components/schemas/ReservationRecord"
            },
            "title": "Reservations",
            "type": "array"
          },
          "reservations_truncated": {
            "title": "Reservations Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "active_lease_count",
          "reservation_count",
          "assigned_address_count",
          "pool_address_count",
          "leases_truncated",
          "reservations_truncated",
          "leases",
          "reservations",
          "pools"
        ],
        "title": "LeaseDashboardResponse",
        "type": "object"
      },
      "LeaseRecord": {
        "description": "Active IPv4 lease returned by KEA.",
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "cltt": {
            "title": "Cltt",
            "type": "integer"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "hw_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hw Address"
          },
          "ip_address": {
            "format": "ipv4",
            "title": "Ip Address",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "integer"
          },
          "subnet_id": {
            "title": "Subnet Id",
            "type": "integer"
          },
          "valid_lft": {
            "title": "Valid Lft",
            "type": "integer"
          }
        },
        "required": [
          "ip_address",
          "subnet_id",
          "state",
          "cltt",
          "valid_lft",
          "expires_at"
        ],
        "title": "LeaseRecord",
        "type": "object"
      },
      "LeaseRequest": {
        "additionalProperties": false,
        "description": "Restricted KEA command envelope for IPv4 lease operations.",
        "properties": {
          "arguments": {
            "$ref": "#/components/schemas/LeaseArguments"
          },
          "command": {
            "enum": [
              "lease4-get",
              "lease4-del"
            ],
            "title": "Command",
            "type": "string"
          },
          "service": {
            "items": {
              "const": "dhcp4",
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "title": "Service",
            "type": "array"
          }
        },
        "required": [
          "command",
          "service",
          "arguments"
        ],
        "title": "LeaseRequest",
        "type": "object"
      },
      "PoolUsage": {
        "description": "Current allocation statistics for a configured IPv4 pool.",
        "properties": {
          "assigned": {
            "title": "Assigned",
            "type": "integer"
          },
          "pool": {
            "title": "Pool",
            "type": "string"
          },
          "subnet": {
            "title": "Subnet",
            "type": "string"
          },
          "subnet_id": {
            "title": "Subnet Id",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "utilization": {
            "title": "Utilization",
            "type": "number"
          }
        },
        "required": [
          "subnet_id",
          "subnet",
          "pool",
          "assigned",
          "total",
          "utilization"
        ],
        "title": "PoolUsage",
        "type": "object"
      },
      "ReservationRecord": {
        "description": "Configured IPv4 reservation.",
        "properties": {
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier"
          },
          "identifier_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier Type"
          },
          "ip_address": {
            "anyOf": [
              {
                "format": "ipv4",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "subnet_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subnet Id"
          }
        },
        "title": "ReservationRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DHCP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/cache": {
      "delete": {
        "description": "Flush the cached KEA DHCP configuration from Redis.",
        "operationId": "flush_cache_admin_cache_delete",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Flush Cache Admin Cache Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Flush Cache"
      }
    },
    "/config": {
      "get": {
        "description": "Get the running KEA DHCP Configuration.",
        "operationId": "get_config_config_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Config Config Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Config"
      }
    },
    "/healthcheck": {
      "get": {
        "description": "Execute healthcheck.",
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Healthcheck Healthcheck Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Healthcheck"
      }
    },
    "/lease": {
      "post": {
        "description": "Proxy a supported IPv4 lease command to KEA.",
        "operationId": "proxy_lease_command_lease_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Proxy Lease Command Lease Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Proxy Lease Command"
      }
    },
    "/lease-dashboard": {
      "get": {
        "description": "Return bounded lease, reservation, and pool data for operators.",
        "operationId": "get_lease_dashboard_lease_dashboard_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseDashboardResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Lease Dashboard"
      }
    },
    "/whoami": {
      "get": {
        "description": "Reflect the caller's identity as seen by this service.",
        "operationId": "whoami_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current User Info"
      }
    }
  }
}
