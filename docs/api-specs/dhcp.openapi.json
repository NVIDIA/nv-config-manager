{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LeaseArguments": {
        "additionalProperties": false,
        "description": "Arguments accepted by the supported KEA lease commands.",
        "properties": {
          "ip-address": {
            "format": "ipv4",
            "title": "Ip-Address",
            "type": "string"
          }
        },
        "required": [
          "ip-address"
        ],
        "title": "LeaseArguments",
        "type": "object"
      },
      "LeaseRequest": {
        "additionalProperties": false,
        "description": "Restricted KEA command envelope for IPv4 lease operations.",
        "properties": {
          "arguments": {
            "$ref": "#/components/schemas/LeaseArguments"
          },
          "command": {
            "enum": [
              "lease4-get",
              "lease4-del"
            ],
            "title": "Command",
            "type": "string"
          },
          "service": {
            "items": {
              "const": "dhcp4",
              "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "title": "Service",
            "type": "array"
          }
        },
        "required": [
          "command",
          "service",
          "arguments"
        ],
        "title": "LeaseRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DHCP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/cache": {
      "delete": {
        "description": "Flush the cached KEA DHCP configuration from Redis.",
        "operationId": "flush_cache_admin_cache_delete",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Flush Cache Admin Cache Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Flush Cache"
      }
    },
    "/config": {
      "get": {
        "description": "Get the running KEA DHCP Configuration.",
        "operationId": "get_config_config_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Config Config Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Config"
      }
    },
    "/healthcheck": {
      "get": {
        "description": "Execute healthcheck.",
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Healthcheck Healthcheck Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Healthcheck"
      }
    },
    "/lease": {
      "post": {
        "description": "Proxy a supported IPv4 lease command to KEA.",
        "operationId": "proxy_lease_command_lease_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Proxy Lease Command Lease Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Proxy Lease Command"
      }
    },
    "/whoami": {
      "get": {
        "description": "Reflect the caller's identity as seen by this service.",
        "operationId": "whoami_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current User Info"
      }
    }
  }
}
