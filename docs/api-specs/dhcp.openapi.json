{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IpVersion": {
        "description": "Supported DHCP address families.",
        "enum": [
          4,
          6
        ],
        "title": "IpVersion",
        "type": "integer"
      },
      "LeaseDashboardResponse": {
        "description": "Lease, reservation, and pool data used by the splash-page dashboard.",
        "properties": {
          "active_lease_count": {
            "title": "Active Lease Count",
            "type": "integer"
          },
          "assigned_address_count": {
            "title": "Assigned Address Count",
            "type": "integer"
          },
          "leases": {
            "items": {
              "$ref": "#/components/schemas/LeaseRecord"
            },
            "title": "Leases",
            "type": "array"
          },
          "leases_truncated": {
            "title": "Leases Truncated",
            "type": "boolean"
          },
          "pool_address_count": {
            "title": "Pool Address Count",
            "type": "integer"
          },
          "pools": {
            "items": {
              "$ref": "#/components/schemas/PoolUsage"
            },
            "title": "Pools",
            "type": "array"
          },
          "reservation_count": {
            "title": "Reservation Count",
            "type": "integer"
          },
          "reservations": {
            "items": {
              "$ref": "#/components/schemas/ReservationRecord"
            },
            "title": "Reservations",
            "type": "array"
          },
          "reservations_truncated": {
            "title": "Reservations Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "active_lease_count",
          "reservation_count",
          "assigned_address_count",
          "pool_address_count",
          "leases_truncated",
          "reservations_truncated",
          "leases",
          "reservations",
          "pools"
        ],
        "title": "LeaseDashboardResponse",
        "type": "object"
      },
      "LeasePageResponse": {
        "description": "Bounded page of normalized leases.",
        "properties": {
          "leases": {
            "items": {
              "$ref": "#/components/schemas/LeaseRecord"
            },
            "title": "Leases",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "leases"
        ],
        "title": "LeasePageResponse",
        "type": "object"
      },
      "LeaseRecord": {
        "description": "Active lease returned by the DHCP service.",
        "properties": {
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "cltt": {
            "title": "Cltt",
            "type": "integer"
          },
          "duid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duid"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "hw_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hw Address"
          },
          "ip_address": {
            "format": "ipvanyaddress",
            "title": "Ip Address",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "integer"
          },
          "subnet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subnet"
          },
          "valid_lft": {
            "title": "Valid Lft",
            "type": "integer"
          }
        },
        "required": [
          "ip_address",
          "state",
          "cltt",
          "valid_lft",
          "expires_at"
        ],
        "title": "LeaseRecord",
        "type": "object"
      },
      "PoolUsage": {
        "description": "Current allocation statistics for a configured address pool.",
        "properties": {
          "assigned": {
            "title": "Assigned",
            "type": "integer"
          },
          "pool": {
            "title": "Pool",
            "type": "string"
          },
          "subnet": {
            "title": "Subnet",
            "type": "string"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "utilization": {
            "title": "Utilization",
            "type": "number"
          }
        },
        "required": [
          "subnet",
          "pool",
          "assigned",
          "total",
          "utilization"
        ],
        "title": "PoolUsage",
        "type": "object"
      },
      "ReservationRecord": {
        "description": "Configured address reservation.",
        "properties": {
          "hostname": {
            "default": "",
            "title": "Hostname",
            "type": "string"
          },
          "identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier"
          },
          "identifier_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Identifier Type"
          },
          "ip_address": {
            "anyOf": [
              {
                "format": "ipvanyaddress",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "subnet": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subnet"
          }
        },
        "title": "ReservationRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WhoamiResponse": {
        "description": "Response shape for ``GET /whoami``.",
        "properties": {
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "user": {
            "title": "User",
            "type": "string"
          }
        },
        "required": [
          "user",
          "roles"
        ],
        "title": "WhoamiResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "JWT",
        "description": "Bearer JWT used by CLI and machine clients on svc-* endpoints. Authentication is required by default, but deployments may disable it with [auth] required = false. Browser OIDC sessions, mTLS, SPIFFE identities, and trusted gateway identity headers may also satisfy authentication outside this generated client flow.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "DHCP API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/cache": {
      "delete": {
        "description": "Flush the cached KEA DHCP configuration from Redis.",
        "operationId": "flush_cache_admin_cache_delete",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Flush Cache Admin Cache Delete",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Flush Cache"
      }
    },
    "/config": {
      "get": {
        "description": "Get the running KEA DHCP Configuration.",
        "operationId": "get_config_config_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "default": 4,
              "title": "Ip Version",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Get Config Config Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Config"
      }
    },
    "/healthcheck": {
      "get": {
        "description": "Execute healthcheck.",
        "operationId": "healthcheck_healthcheck_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Healthcheck Healthcheck Get",
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [],
        "summary": "Healthcheck"
      }
    },
    "/lease": {
      "delete": {
        "description": "Delete one lease from the selected DHCP service.",
        "operationId": "delete_lease_lease_delete",
        "parameters": [
          {
            "in": "query",
            "name": "ip_address",
            "required": true,
            "schema": {
              "format": "ipvanyaddress",
              "title": "Ip Address",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/IpVersion",
              "default": 4
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Lease not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Delete Lease"
      },
      "get": {
        "description": "Return one normalized lease from the selected DHCP service.",
        "operationId": "get_lease_lease_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_address",
            "required": true,
            "schema": {
              "format": "ipvanyaddress",
              "title": "Ip Address",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/IpVersion",
              "default": 4
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Lease not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Lease"
      }
    },
    "/lease-dashboard": {
      "get": {
        "description": "Return bounded lease, reservation, and pool data for operators.",
        "operationId": "get_lease_dashboard_lease_dashboard_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/IpVersion",
              "default": 4
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaseDashboardResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Lease Dashboard"
      }
    },
    "/leases": {
      "get": {
        "description": "Return a cursor-paginated, optionally filtered page of normalized leases.",
        "operationId": "list_leases_leases_get",
        "parameters": [
          {
            "in": "query",
            "name": "ip_version",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/IpVersion",
              "default": 4
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeasePageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Leases"
      }
    },
    "/whoami": {
      "get": {
        "description": "Reflect the caller's identity as seen by this service.",
        "operationId": "whoami_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Current User Info"
      }
    }
  }
}
