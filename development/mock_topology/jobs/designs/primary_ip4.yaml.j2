---

# Assign primary IP4 address to each device from JSON data.
# This must be done in a separate file because the device and address must already exist.

# Uses the explicitly configured primary IPv4 interface.

{% if json.devices is defined and json.devices | length > 0 %}
devices:
  {% for device in json.devices %}
  {% set primary_ip = namespace(found=false, address='') %}
  {% if device.primary_ip4_interface is defined %}
  {% for interface in device.interfaces | default([]) %}
  {% if interface.name == device.primary_ip4_interface %}
  {% for ip_address in interface.ip_addresses | default([]) %}
  {% if not primary_ip.found and ip_address.ip_version == 4 %}
  {% set primary_ip.found = true %}
  {% set primary_ip.address = ip_address.address %}
  {% endif %}
  {% endfor %}
  {% endif %}
  {% endfor %}
  {% endif %}
  {% if primary_ip.found %}
  - "!create_or_update:name": {{ device.name }}
    "!create_or_update:location": "!ref:location"
    primary_ip4:
      "!get:address": {{ primary_ip.address }}
  {% endif %}
  {% endfor %}
{% else %}
devices: []
{% endif %}
