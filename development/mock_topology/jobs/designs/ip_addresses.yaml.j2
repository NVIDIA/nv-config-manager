---

{% if json.devices is defined and json.devices | length > 0 %}
ip_addresses:
  {% for device in json.devices %}
  {% for intf in device.interfaces %}
  {% for ip in intf.ip_addresses %}
  {% if ip.address %}
  - "!create_or_update:address": {{ ip.address }}
    {% if ip.parent_prefix is defined and ip.parent_prefix %}
    "!create_or_update:parent__prefix": {{ ip.parent_prefix }}
    "!create_or_update:parent__namespace__name": {{ global_defaults.namespace }}
    {% endif %}
    status__name: {{ global_defaults.ip_address_status }}
    {% set is_mgmt = intf.name == 'eth0' or intf.name.startswith('Management') or intf.mgmt_only %}
    {% set is_uplink = intf.role is defined and intf.role and intf.role.name == 'Uplink' %}
    {% set is_smn = device.role is defined and device.role and device.role.name.startswith('SMN') %}
    {% set is_dhcp_pool = intf.dhcp_pool | default(false) %}
    {% set is_dhcp_reserve = intf.dhcp_reserve | default(false) %}
    {% if is_dhcp_pool %}
    tags:
      - "!get:name": dhcp-pool
    {% elif is_dhcp_reserve or is_mgmt %}
    tags:
      - "!get:name": dhcp-reserve
    {% elif is_smn and is_uplink %}
    {# SMN uplinks use pools, not reservations #}
    tags:
      - "!get:name": dhcp-pool
    {% endif %}
  {% endif %}
  {% endfor %}
  {% endfor %}
  {% endfor %}
{% else %}
ip_addresses: []
{% endif %}
