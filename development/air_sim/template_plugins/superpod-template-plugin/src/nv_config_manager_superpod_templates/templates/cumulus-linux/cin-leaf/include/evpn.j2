{% set attached_vrfs = device_data|attached_vrfs|rejectattr("vni", "none")|sort(attribute="vni") %}
{% if attached_vrfs|length > 0 %}
    nve:
      vxlan:
        state: enabled
    evpn:
      state: enabled
      vni:
{% for vrf in attached_vrfs %}
        '{{ vrf.vni }}':
          rd: {{ device_data|router_id }}:{{ vrf.vni }}
          route-target:
            export:
              {{ device_data|asn|asplain }}:{{ vrf.vni }}: {}
            import:
              {{ device_data|asn|asplain }}:{{ vrf.vni }}: {}
{% endfor %}
{% endif %}
