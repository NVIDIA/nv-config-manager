# NVIDIA Config Manager UI - local development environment
#
# Copy to .env.local and edit (`.env.local` is gitignored):
#
#   cp .env.example .env.local
#
# Notes:
# - Variables WITHOUT `NEXT_PUBLIC_` are read server-side by /api/config (app/api/config/route.ts)
#   and are not inlined into the browser bundle. Values returned by /api/config are visible to clients.
# - Variables WITH `NEXT_PUBLIC_` are inlined into the client bundle at build time.

# ---------------------------------------------------------------------------
# Backend services (read by /api/config at request time)
# ---------------------------------------------------------------------------
#
# Defaults (set in code) are http://localhost:9000 — appropriate when running
# uvicorn locally. For a kind/local-up cluster, use the Envoy Gateway routes
# with the base hostname configured for the cluster.
#
# Add to /etc/hosts so the gateway can route by Host header:
#   127.0.0.1 config-manager.local \
#             workflow.config-manager.local \
#             nautobot.config-manager.local \
#             config-store.config-manager.local \
#             render.config-manager.local \
#             ztp.config-manager.local \
#             dhcp.config-manager.local \
#             temporal-ui.config-manager.local \
#             grafana.config-manager.local
#
# The kind installer issues a self-signed cert. The browser will warn on first
# visit to each subdomain; accept once per origin, or trust the CA.

# WORKFLOW_API_URL=https://workflow.config-manager.local
# CONFIG_STORE_API_URL=https://config-store.config-manager.local
# NAUTOBOT_URL=https://nautobot.config-manager.local
# RENDER_SERVICE_URL=https://render.config-manager.local
# ZTP_URL=https://ztp.config-manager.local
# DHCP_URL=https://dhcp.config-manager.local
# TEMPORAL_UI_URL=https://temporal-ui.config-manager.local
# GRAFANA_URL=https://grafana.config-manager.local
# APP_VERSION=development

# ---------------------------------------------------------------------------
# MSW (Mock Service Worker)
# ---------------------------------------------------------------------------
#
# In `next dev`, MSW intercepts all fetches with mock data from src/mocks/handlers.
# Set this to "true" to disable MSW and talk to the real backend URLs above.

# NEXT_PUBLIC_BYPASS_MSW=true
