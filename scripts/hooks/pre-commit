# Pre-commit hook to format staged Python files and verify SPDX license headers.
# Install with: ./scripts/install-hooks.sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

check_gpg_signing() {
    local signing_enabled
    local signing_key
    local signing_format
    local gpg_program
    local secret_key_output

    signing_enabled="$(git config --bool --get commit.gpgsign 2>/dev/null || true)"
    signing_key="$(git config --get user.signingkey 2>/dev/null || true)"
    signing_format="$(git config --get gpg.format 2>/dev/null || true)"

    # OpenPGP is Git's default when gpg.format is unset.
    if [[ -z "$signing_format" ]]; then
        signing_format="openpgp"
    fi

    if [[ "$signing_enabled" != "true" || -z "$signing_key" || "$signing_format" != "openpgp" ]]; then
        echo -e "${RED}ERROR: OpenPGP commit signing is not configured.${NC}"
        echo ""
        echo "NVIDIA trustees need GitHub-verified commits for copy-pr-bot auto-sync."
        echo "List your GPG keys and configure one for this repository:"
        echo ""
        echo "  gpg --list-secret-keys --keyid-format=long"
        echo "  ./scripts/configure-gpg-signing.sh <GPG_KEY_ID_OR_FINGERPRINT>"
        echo ""
        exit 1
    fi

    gpg_program="$(git config --get gpg.program 2>/dev/null || true)"
    if [[ -z "$gpg_program" ]]; then
        if command -v gpg >/dev/null 2>&1; then
            gpg_program="gpg"
        elif command -v gpg2 >/dev/null 2>&1; then
            gpg_program="gpg2"
        else
            echo -e "${RED}ERROR: Neither 'gpg' nor 'gpg2' was found in PATH.${NC}"
            echo "Install GnuPG, then run ./scripts/configure-gpg-signing.sh."
            exit 1
        fi
    elif ! command -v "$gpg_program" >/dev/null 2>&1; then
        echo -e "${RED}ERROR: Configured GPG program '$gpg_program' was not found.${NC}"
        echo "Run ./scripts/configure-gpg-signing.sh again after installing GnuPG."
        exit 1
    fi

    secret_key_output="$(
        "$gpg_program" --batch --with-colons --list-secret-keys "$signing_key" 2>/dev/null || true
    )"
    if ! printf '%s\n' "$secret_key_output" | grep '^sec:' >/dev/null; then
        echo -e "${RED}ERROR: Configured GPG secret key '$signing_key' was not found.${NC}"
        echo ""
        echo "Import the secret key or configure a key available on this machine:"
        echo ""
        echo "  gpg --list-secret-keys --keyid-format=long"
        echo "  ./scripts/configure-gpg-signing.sh <GPG_KEY_ID_OR_FINGERPRINT>"
        echo ""
        exit 1
    fi

    echo -e "${GREEN}✓ OpenPGP commit signing configured${NC}"
}

check_gpg_signing

EXTENSIONS=("py" "ts" "tsx" "js" "jsx" "mjs" "cjs" "go")

CHECK_DIRS=(
    "src/"
    "ui/src/"
    "ui/tests/"
    "components/"
    "db/migrations/"
    "scripts/"
    "development/"
    "installer/src/"
    "installer/tests/"
    "installer/scripts/"
)

SKIP_PATTERNS=(
    "__pycache__"
    "node_modules"
    ".git"
    ".mypy_cache"
    ".pytest_cache"
    ".ruff_cache"
    ".venv"
    "build/"
    "dist/"
)

SPDX_IDENTIFIER="SPDX-License-Identifier: Apache-2.0"
LICENSE_TEXT="Licensed under the Apache License"

missing_files=()
checked_count=0

staged_files=()
while IFS= read -r -d '' staged_file; do
    staged_files+=("$staged_file")
done < <(git diff --cached --name-only -z --diff-filter=ACM)

should_skip() {
    local file="$1"
    for pattern in "${SKIP_PATTERNS[@]}"; do
        if [[ "$file" == *"$pattern"* ]]; then
            return 0
        fi
    done
    return 1
}

is_in_check_dir() {
    local file="$1"
    for dir in "${CHECK_DIRS[@]}"; do
        if [[ "$file" == "$dir"* ]]; then
            return 0
        fi
    done
    return 1
}

has_extension() {
    local file="$1"
    local ext="${file##*.}"
    for check_ext in "${EXTENSIONS[@]}"; do
        if [[ "$ext" == "$check_ext" ]]; then
            return 0
        fi
    done
    return 1
}

check_spdx_header() {
    local file="$1"

    if [[ "$(git cat-file -s ":$file")" == "0" ]]; then
        return 0
    fi

    if git show ":$file" | head -n 20 | grep -q "$SPDX_IDENTIFIER" && \
        git show ":$file" | head -n 20 | grep -q "$LICENSE_TEXT"; then
        return 0
    fi

    return 1
}

find_ruff_project_dir() {
    local file="$1"
    local dir
    dir="$(dirname "$file")"

    while [[ "$dir" != "." && "$dir" != "/" ]]; do
        if [[ -f "$dir/pyproject.toml" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done

    echo "."
}

add_unique_project_dir() {
    local project_dir="$1"
    local existing

    for existing in "${ruff_project_dirs[@]}"; do
        if [[ "$existing" == "$project_dir" ]]; then
            return 0
        fi
    done

    ruff_project_dirs+=("$project_dir")
}

format_project_python_files() {
    local project_dir="$1"
    local project_files=()
    local file
    local file_project_dir

    for file in "${staged_py_files[@]}"; do
        file_project_dir="$(find_ruff_project_dir "$file")"
        if [[ "$file_project_dir" != "$project_dir" ]]; then
            continue
        fi

        if [[ "$project_dir" == "." ]]; then
            project_files+=("$file")
        else
            project_files+=("${file#"$project_dir/"}")
        fi
    done

    if [[ ${#project_files[@]} -eq 0 ]]; then
        return 0
    fi

    if [[ "$project_dir" == "." ]]; then
        echo -e "${YELLOW}Running ruff format on ${#project_files[@]} staged Python file(s) in repo root...${NC}"
        uv run ruff format "${project_files[@]}"
    else
        echo -e "${YELLOW}Running ruff format on ${#project_files[@]} staged Python file(s) in ${project_dir}...${NC}"
        (cd "$project_dir" && uv run ruff format "${project_files[@]}")
    fi
}

# --- Ruff formatting ---
staged_py_files=()
for file in "${staged_files[@]}"; do
    if should_skip "$file"; then
        continue
    fi

    if [[ "$file" == *.py && -f "$file" ]]; then
        staged_py_files+=("$file")
    fi
done

if [[ ${#staged_py_files[@]} -gt 0 ]]; then
    ruff_project_dirs=()
    for file in "${staged_py_files[@]}"; do
        add_unique_project_dir "$(find_ruff_project_dir "$file")"
    done

    for project_dir in "${ruff_project_dirs[@]}"; do
        format_project_python_files "$project_dir"
    done

    git add "${staged_py_files[@]}"
    echo -e "${GREEN}✓ Formatted ${#staged_py_files[@]} Python file(s)${NC}"
fi

# --- SPDX header checks ---
echo -e "${YELLOW}Checking SPDX license headers...${NC}"

for file in "${staged_files[@]}"; do
    if ! is_in_check_dir "$file"; then
        continue
    fi

    if ! has_extension "$file"; then
        continue
    fi

    if should_skip "$file"; then
        continue
    fi

    ((checked_count += 1))

    if ! check_spdx_header "$file"; then
        missing_files+=("$file")
    fi
done

if [[ ${#missing_files[@]} -gt 0 ]]; then
    echo -e "${RED}ERROR: The following files are missing full SPDX license headers:${NC}"
    echo ""
    for file in "${missing_files[@]}"; do
        echo -e "  ${RED}✗${NC} $file"
    done
    echo ""
    echo -e "${YELLOW}Required header for Python files:${NC}"
    echo "  # SPDX-FileCopyrightText: Copyright (c) 2024-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved."
    echo "  # SPDX-License-Identifier: Apache-2.0"
    echo "  #"
    echo "  # Licensed under the Apache License, Version 2.0 (the \"License\");"
    echo "  # ..."
    echo ""
    echo -e "${YELLOW}Required header for TypeScript/JavaScript/Go files:${NC}"
    echo "  /*"
    echo "   * SPDX-FileCopyrightText: Copyright (c) 2024-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved."
    echo "   * SPDX-License-Identifier: Apache-2.0"
    echo "   * ..."
    echo "   */"
    echo ""
    echo -e "Run ${GREEN}uv run python scripts/add_spdx_headers.py${NC}, then re-stage the modified files."
    echo ""
    exit 1
fi

if [[ $checked_count -gt 0 ]]; then
    echo -e "${GREEN}✓ All $checked_count checked files have valid SPDX headers${NC}"
fi

exit 0
