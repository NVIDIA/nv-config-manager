#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2024-2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Point a Kind cluster's in-cluster containerd at a Docker Hub pull-through
# mirror so that anonymous docker.io pulls from inside the cluster are served
# from the cache instead of registry-1.docker.io directly.
#
# Why: in-cluster pulls draw on the shared CI runner IP's anonymous Docker Hub
# budget (~100/6h). Once exhausted, any further pull 429s into ImagePullBackOff
# and helm's --wait stalls until the deploy timeout. The runner's *host* Docker
# already uses this mirror (via the setup-proxy-cache action), but Kind's
# containerd does its own pulls and bypasses it. Adding a containerdConfigPatches
# mirror fixes every docker.io image at once, which is why this supersedes the
# per-image preload in the Makefile. The secure bring-up (SPIRE + Keycloak + the
# app) is the heaviest consumer, but any deploy path that pulls a docker.io image
# in-cluster can hit the limit, so CI applies this to all of them.
#
# The mirror endpoint is discovered from (in order):
#   1. the DOCKERHUB_MIRROR environment variable, or
#   2. /etc/buildkit/buildkitd.toml on the runner (the nv-gha-runners fleet
#      configures it there).
#
# If no mirror can be discovered this prints nothing and exits 0; the caller
# decides what to do. CI treats an empty result as fatal for the security run
# (no image-preload fallback there) and as a warning for the plain and
# observability runs, which pull few enough docker.io images to usually fit in
# the budget.
#
# Usage:
#   configure-kind-dockerhub-mirror --input deploy/kind-config.yaml \
#       --output "${RUNNER_TEMP}/kind-config-mirror.yaml"
# On success the discovered mirror URL is printed to stdout and OUTPUT contains a
# patched copy of INPUT; when no mirror is found nothing is printed and OUTPUT is
# left untouched.

set -euo pipefail

input=""
output=""

while [ $# -gt 0 ]; do
    case "$1" in
        --input)
            input="$2"
            shift 2
            ;;
        --output)
            output="$2"
            shift 2
            ;;
        *)
            echo "unknown argument: $1" >&2
            exit 2
            ;;
    esac
done

if [ -z "${input}" ] || [ -z "${output}" ]; then
    echo "usage: $0 --input FILE --output FILE" >&2
    exit 2
fi

discover_mirror() {
    if [ -n "${DOCKERHUB_MIRROR:-}" ]; then
        printf '%s' "${DOCKERHUB_MIRROR}"
        return
    fi

    local buildkit_config="/etc/buildkit/buildkitd.toml"
    if [ -f "${buildkit_config}" ]; then
        # Extract the mirror endpoint ONLY from the [registry."docker.io"]
        # section. buildkitd.toml can define mirrors for several registries, so
        # grabbing the first `mirrors =` anywhere would misassign another
        # registry's endpoint to docker.io -- and since this mirror is the only
        # backstop for in-cluster pulls, a wrong or unreachable endpoint would
        # break every one of them. Tolerates single- or double-quoted values.
        awk '
            /^\[registry\."docker\.io"\][[:space:]]*$/ { in_docker_hub = 1; next }
            /^\[/ { in_docker_hub = 0 }
            in_docker_hub && /^[[:space:]]*mirrors[[:space:]]*=/ { print; exit }
        ' "${buildkit_config}" 2>/dev/null |
            sed -nE "s/.*mirrors[[:space:]]*=[[:space:]]*\[?[[:space:]]*[\"']([^\"']+)[\"'].*/\1/p"
    fi
}

mirror="$(discover_mirror)"
mirror="${mirror%/}"

if [ -z "${mirror}" ]; then
    # No mirror available -- print nothing and let the caller decide (the CI
    # security run treats this as fatal).
    exit 0
fi

case "${mirror}" in
    http://*|https://*) ;;
    *) mirror="https://${mirror}" ;;
esac

cp "${input}" "${output}"

if grep -q 'registry\.mirrors\."docker\.io"' "${output}"; then
    # Already patched -- leave it and just report the mirror.
    printf '%s\n' "${mirror}"
    exit 0
fi

if grep -q '^containerdConfigPatches:' "${output}"; then
    tmp="$(mktemp)"
    awk -v mirror="${mirror}" '
        /^containerdConfigPatches:/ {
            print
            print "  - |-"
            print "    [plugins.\"io.containerd.grpc.v1.cri\".registry.mirrors.\"docker.io\"]"
            print "      endpoint = [\"" mirror "\"]"
            next
        }
        { print }
    ' "${output}" > "${tmp}"
    mv "${tmp}" "${output}"
else
    cat >> "${output}" <<EOF

containerdConfigPatches:
  - |-
    [plugins."io.containerd.grpc.v1.cri".registry.mirrors."docker.io"]
      endpoint = ["${mirror}"]
EOF
fi

printf '%s\n' "${mirror}"
